# Copy to .env and replace each placeholder with your own setting.
# Obtain the source publication from ATC and set your own local PDF path.
RAG_ATC_PDF_FILE="/path/to/your/ATC-20-1.pdf"
RAG_ATC_KB_DIR="/path/to/your/codebook_database"
RAG_ATC_API_KEY="your-api-key"
RAG_ATC_BASE_URL="https://your-provider.example/v1"
RAG_ATC_LLM_MODEL="your-chat-model"
RAG_ATC_EMBED_MODEL="your-embedding-model"
RAG_ATC_EMBED_DIM="1024"
